{
  "type": "object",
  "required": ["website", "topics", "pc", "cycles"],
  "properties": {
    "website": {
      "type": "object",
      "required": ["url", "archive"],
      "properties": {
        "url": {
          "type": ["string", "null"],
          "format": "uri"
        },
        "archive": {
          "type": ["string", "null"],
          "format": "uri"
        }
      },
      "oneOf": [
        {
          "properties": {
            "url": {
              "type": "string"
            },
            "archive": {
              "type": "null"
            }
          }
        },
        {
          "properties": {
            "archive": {
              "type": "string"
            },
            "url": {
              "type": "null"
            }
          }
        }
      ],
      "additionalProperties": false
    },

    "proceedings": {
      "type": "object",
      "required": ["url", "open"],
      "properties": {
        "url": {
          "type": "string",
          "format": "uri"
        },
        "open": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },

    "topics": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "type": "object",
            "minProperties": 1,
            "maxProperties": 1,
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        ]
      }
    },

    "pc": {
      "type": "array",
      "items": {
        "type": "object",
        "minProperties": 1,
        "maxProperties": 1,
        "additionalProperties": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },

    "cycles": {
      "type": "array",
      "items": {
        "type": "object",
        "minProperties": 1,
        "maxProperties": 1,
        "additionalProperties": {
          "type": "object",
          "properties": {
            "abstract": { "type": "string" },
            "submission": { "type": "string" },
            "early-reject": { "type": "string" },
            "rebuttal-start": { "type": "string" },
            "rebuttal-end": { "type": "string" },
            "notification": { "type": "string" },
            "shepherding-submission": { "type": "string" },
            "shepherding-notification": { "type": "string" },
            "revision-submission": { "type": "string" },
            "revision-notification": { "type": "string" },
            "camera-ready": { "type": "string" }
          },
          "additionalProperties": false
        }
      }
    },

    "artifacts": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "format": "uri"
        },
        "at-submission": {
          "$ref": "#/$defs/requirementLevel"
        },
        "evaluation": {
          "type": "object",
          "properties": {
            "badges": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "acm-available",
                  "acm-evaluated-functional",
                  "acm-evaluated-reusable",
                  "acm-reproduced",
                  "usenix-available",
                  "usenix-functional",
                  "usenix-reproduced"
                ]
              },
              "uniqueItems": true
            },
            "appendix": {
              "$ref": "#/$defs/requirementLevel"
            },
            "packaging": {
              "$ref": "#/$defs/requirementLevel"
            },
            "mandatory-available": {
              "type": "boolean"
            },
            "hosting-limitations": {
              "type": "boolean"
            },
            "research-infrastructure": {
              "type": "boolean"
            },
            "secartifacts-instructions": {
              "type": "boolean"
            },
            "awards": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "url",
        "at-submission",
        "evaluation"
      ],
      "additionalProperties": false
    },

    "anonymous": { "type": "boolean" },
    "conflicts": { "type": "boolean" },
    "ethics-discussion": { "type": "boolean" },
    "meta-review": { "type": "boolean" },
    "anonymous-cves": { "type": "boolean" },
    "genai": { "type": "boolean" }
  },

  "additionalProperties": false,
  "$defs": {
    "requirementLevel": {
      "oneOf": [
        {
          "type": "string",
          "enum": ["required", "optional"]
        },
        {
          "type": "boolean",
          "const": false
        }
      ]
    }
  }
}
