{
  "type": "object",
  "required": [
    "website",
    "topics",
    "pc",
    "cycles"
  ],
  "properties": {
    "website": {
      "description": "URL to the website or the call for papers. If the page is accessible, this should go to the url field, otherwise an Internet Archive snapshot should go in the archive field. In both cases, the other field should be null.",
      "type": "object",
      "required": [
        "url",
        "archive"
      ],
      "properties": {
        "url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "archive": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        }
      },
      "oneOf": [
        {
          "properties": {
            "url": {
              "type": "string"
            },
            "archive": {
              "type": "null"
            }
          }
        },
        {
          "properties": {
            "archive": {
              "type": "string"
            },
            "url": {
              "type": "null"
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "proceedings": {
      "type": "object",
      "description": "Link to the published conference proceedings and whether they are open access.",
      "required": [
        "url",
        "open"
      ],
      "properties": {
        "url": {
          "type": "string",
          "format": "uri"
        },
        "open": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "topics": {
      "type": "array",
      "description": "Topics of interest posted in the CFP.",
      "items": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "type": "object",
            "minProperties": 1,
            "maxProperties": 1,
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        ]
      }
    },
    "pc": {
      "type": "array",
      "description": "Members of the program committee.",
      "items": {
        "type": "object",
        "minProperties": 1,
        "maxProperties": 1,
        "additionalProperties": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "cycles": {
      "type": "array",
      "description": "List of submission cycles and all the separate deadlines within a cycle.",
      "items": {
        "type": "object",
        "minProperties": 1,
        "maxProperties": 1,
        "additionalProperties": {
          "type": "object",
          "properties": {
            "abstract": {
              "type": "string"
            },
            "submission": {
              "type": "string"
            },
            "early-reject": {
              "type": "string"
            },
            "rebuttal-start": {
              "type": "string"
            },
            "rebuttal-end": {
              "type": "string"
            },
            "notification": {
              "type": "string"
            },
            "shepherding-submission": {
              "type": "string"
            },
            "shepherding-notification": {
              "type": "string"
            },
            "revision-submission": {
              "type": "string"
            },
            "revision-notification": {
              "type": "string"
            },
            "camera-ready": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      }
    },
    "anonymous": {
      "type": "boolean",
      "description": "Whether the CFP mentions that papers have to be submitted anonymously."
    },
    "conflicts": {
      "type": "boolean",
      "description": "Whether the CFP mentions declaration of conflicts of interest."
    },
    "ethics-discussion": {
      "type": "boolean",
      "description": "Whether the CFP discusses ethical considerations."
    },
    "meta-review": {
      "type": "boolean",
      "description": "Whether a meta-review is published alongside accepted papers."
    },
    "anonymous-cves": {
      "type": "boolean",
      "description": "Whether CVE identifiers have to be anonymized in the submission."
    },
    "genai": {
      "type": "boolean",
      "description": "Whether the CFP offers guidance or rules on LLM usage/declaration."
    },
    "artifacts": {
      "type": "object",
      "properties": {
        "at-submission": {
          "$ref": "#/$defs/requirementLevel",
          "description": "Artifacts need to be submitted at paper submission time."
        },
        "evaluation": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "badges": {
                  "type": "array",
                  "description": "List of awarded badges.",
                  "items": {
                    "type": "string",
                    "enum": [
                      "acm-available",
                      "acm-evaluated-functional",
                      "acm-evaluated-reusable",
                      "acm-reproduced",
                      "usenix-available",
                      "usenix-functional",
                      "usenix-reproduced",
                      "ndss-available",
                      "ndss-functional",
                      "ndss-reproduced",
                      "sp-available",
                      "sp-functional",
                      "sp-reproduced",
                      "ieee-available",
                      "ieee-reviewed",
                      "ieee-reproducible"
                    ]
                  },
                  "uniqueItems": true
                },
                "call": {
                  "type": "string",
                  "description": "URL to the call for artifacts page.",
                  "format": "uri"
                },
                "outcomes": {
                  "type": "string",
                  "description": "URL to the outcomes of the evaluation.",
                  "format": "uri"
                },
                "appendix": {
                  "$ref": "#/$defs/requirementLevel"
                },
                "packaging": {
                  "$ref": "#/$defs/requirementLevel",
                  "description": "Guidance or requirements on the packaging and structure of the artifact."
                },
                "mandatory-available": {
                  "type": "boolean",
                  "description": "Mandatory participation in availability verification."
                },
                "hosting-limitations": {
                  "type": "boolean",
                  "description": "Limitations on which hosting providers are acceptable for available artifacts."
                },
                "research-infrastructure": {
                  "type": "boolean",
                  "description": "Recommended or mandatory to use research infrastructure to run the artifacts."
                },
                "secartifacts-instructions": {
                  "type": "boolean",
                  "description": "Artifact evaluation instructions are hosted on secartifacts"
                },
                "awards": {
                  "type": "boolean"
                }
              },
              "additionalProperties": false
            },
            {
              "type": "boolean",
              "const": false
            }
          ]
        }
      },
      "required": [
        "at-submission",
        "evaluation"
      ],
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "requirementLevel": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "required",
            "optional"
          ]
        },
        {
          "type": "boolean",
          "const": false
        }
      ]
    }
  }
}
